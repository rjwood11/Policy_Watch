{
  "name": "policywatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next build",
    "start": "next start",
    "serve:static": "python -m scripts.serve_static --directory out --host 127.0.0.1",
    "launch:dev": "next dev -H 127.0.0.1",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "data:refresh-weekly": "python -m scripts.refresh.weekly_layers",
    "data:refresh-echo": "python -m scripts.refresh.weekly_layers --source echo --metadata-if-changed",
    "data:refresh-superfund": "python -m scripts.refresh.superfund",
    "data:build-landuse": "python -m scripts.refresh.landuse",
    "data:build": "python -m scripts.summaries.build_prototype_data",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.5.0",
    "next": "15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
