{"year":2025,"retrievedAt":"2026-11-11","sourceUrl":"https://dmsdata.cr.usgs.gov/geoserver/mrlc_Land-Cover-Native_conus_year_data/wcs","resolutionMeters":300,"groundResolutionMeters":250,"resampling":"nearest neighbor","classes":[{"id":1,"label":"Built-up / urban","color":"#c43c39","codes":[22,23,24],"description":"Developed land with housing, roads, businesses or industry. Groups low, medium and high intensity development (20\u2013100% impervious cover)."},{"id":2,"label":"Developed open space","color":"#e8aa8b","codes":[21],"description":"Mostly vegetation within developed settings, including lawns, parks, golf courses and large-lot housing. Less than 20% impervious cover; this is not a rural designation."},{"id":3,"label":"Agriculture","color":"#e5c65c","codes":[81,82],"description":"Pasture and hay fields, cultivated crops and orchards. Combines NLCD pasture/hay and cultivated crop classes."},{"id":4,"label":"Forest","color":"#4e8650","codes":[41,42,43],"description":"Deciduous, evergreen and mixed forest. These wooded areas are common in rural landscapes; NLCD does not assign an official urban/rural designation."},{"id":5,"label":"Grassland / shrubland","color":"#a7b87a","codes":[52,71],"description":"Grass, herbaceous plants and low shrubs, including young woody vegetation. Often open rural landscapes; distinct from the pasture/hay agriculture class."},{"id":6,"label":"Wetlands","color":"#63aaa9","codes":[90,95],"description":"Woody and herbaceous wetlands with periodically saturated soils or standing water. Land-cover mapping does not establish a regulatory wetland boundary."},{"id":7,"label":"Open water","color":"#497fb7","codes":[11],"description":"Lakes, reservoirs, rivers and other open water with little vegetation or exposed soil."},{"id":8,"label":"Barren land","color":"#b1a99d","codes":[31],"description":"Exposed rock, sand or clay with little vegetation, including some quarries and excavated areas."},{"id":9,"label":"Perennial ice / snow","color":"#dc